{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "@cloudflare/workers-types", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "scripts",
    "tests",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test"
  ]
}
